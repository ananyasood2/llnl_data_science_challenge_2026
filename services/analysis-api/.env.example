APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://127.0.0.1:8050
GCP_PROJECT_ID=
GCS_BUCKET_NAME=
DEMO_MODE=true
LOG_LEVEL=INFO
# Optional: enables OpenAI Responses narration after deterministic tools run.
# Leave blank for the fully local deterministic narrator.
OPENAI_API_KEY=
COPILOT_MODEL=gpt-5.6-terra
COPILOT_REASONING_EFFORT=medium
